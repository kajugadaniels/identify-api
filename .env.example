# ─── App ───────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── JWT ───────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ─── Database (Neon PostgreSQL) ─────────────────────
DATABASE_URL=

# ─── FastAPI Engine ─────────────────────────────────
FASTAPI_ENGINE_URL=http://localhost:8000
INTERNAL_API_KEY=

# ─── Rate Limiting ──────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=10