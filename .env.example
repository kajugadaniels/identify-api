# ─── App ───────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── JWT ───────────────────────────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ─── Database (Neon PostgreSQL) ─────────────────────
# Pooled connection string — used by the app at runtime via @prisma/adapter-pg
DATABASE_URL=
# Non-pooled (direct) connection string — used ONLY by the Prisma CLI
# (migrate dev, db push). Neon's pooler blocks DDL / advisory locks.
DIRECT_URL=

# ─── FastAPI Engine ─────────────────────────────────
FASTAPI_ENGINE_URL=http://localhost:8000
INTERNAL_API_KEY=

# ─── Rate Limiting ──────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=10